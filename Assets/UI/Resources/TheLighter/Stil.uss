/* TheLighter: bütün ekranların görünüşü. Ölçüler 1080x1920 dikey referansa göre (Uygulama.cs). */

:root {
    --arka: #15121A;
    --yuzey: #221D29;
    --yuzey-2: #2E2737;
    --cizgi: #433A4F;
    --yazi: #F4EEE6;
    --yazi-soluk: #A79FB0;
    --yazi-koyu: #1A1208;
    --alev: #FF8A1F;
    --alev-acik: #FFA24D;
    --alev-koyu: #3A2A1A;
    --kirmizi: #FF5A5F;
}

/* ---------- Temel ---------- */

.kok {
    flex-grow: 1;
    align-items: center;
    background-color: var(--arka);
}

.sahne {
    flex-grow: 1;
    width: 100%;
    max-width: 1200px;
}

.ekran {
    flex-grow: 1;
    padding: 48px 56px;
}

.esnek {
    flex-grow: 1;
}

.gizli {
    display: none;
}

.satir {
    flex-direction: row;
    align-items: center;
}

.kaydirma {
    flex-grow: 1;
    flex-shrink: 1;
}

.kok .unity-label {
    color: var(--yazi);
    font-size: 40px;
    white-space: normal;
    padding: 0;
    margin: 6px 0;
}

.kok .baslik {
    font-size: 64px;
    -unity-font-style: bold;
    margin: 8px 0 16px 0;
}

.kok .alt-baslik {
    font-size: 44px;
    -unity-font-style: bold;
    margin: 32px 0 8px 0;
}

.kok .aciklama {
    color: var(--yazi-soluk);
    font-size: 40px;
}

.kok .ipucu {
    color: var(--yazi-soluk);
    font-size: 32px;
    -unity-text-align: middle-center;
}

.kok .orta {
    -unity-text-align: middle-center;
}

.kok .hata {
    color: var(--kirmizi);
    font-size: 36px;
    -unity-text-align: middle-center;
}

.kok .sure {
    font-size: 80px;
    -unity-font-style: bold;
    color: var(--alev);
    min-width: 120px;
    -unity-text-align: middle-right;
}

.kok .sure-az {
    color: var(--kirmizi);
}

.kok .sayac {
    color: var(--yazi-soluk);
    font-size: 32px;
}

/* ---------- Butonlar ---------- */

.unity-button.buton {
    background-color: var(--yuzey-2);
    color: var(--yazi);
    border-width: 0;
    border-radius: 28px;
    padding: 24px 40px;
    margin: 10px 0;
    min-height: 120px;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    transition-property: background-color, opacity;
    transition-duration: 0.12s;
}

.unity-button.buton:hover {
    background-color: var(--cizgi);
}

.unity-button.buton:active {
    background-color: var(--alev-koyu);
}

.unity-button.buton:disabled {
    opacity: 0.35;
}

.unity-button.buton-birincil {
    background-color: var(--alev);
    color: var(--yazi-koyu);
}

.unity-button.buton-birincil:hover {
    background-color: var(--alev-acik);
}

.unity-button.buton-birincil:active {
    background-color: var(--alev-acik);
}

.unity-button.buton-ikincil {
    background-color: rgba(0, 0, 0, 0);
    border-width: 3px;
    border-color: var(--cizgi);
}

.unity-button.buton-buyuk {
    min-height: 160px;
    font-size: 54px;
}

.unity-button.buton-kucuk {
    min-height: 0;
    padding: 16px 32px;
    margin: 0;
    font-size: 34px;
    border-radius: 20px;
}

/* ---------- Ana menü ---------- */

.kok .logo {
    font-size: 150px;
    -unity-font-style: bold;
    color: var(--alev);
    -unity-text-align: middle-center;
}

.kok .logo-alt {
    font-size: 44px;
    color: var(--yazi-soluk);
    -unity-text-align: middle-center;
}

.menu-perde {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(10, 8, 14, 0.92);
    justify-content: center;
    padding: 80px 56px;
}

.menu-kutu {
    background-color: var(--yuzey);
    border-radius: 36px;
    padding: 48px;
    max-height: 100%;
}

/* ---------- Kurulum ---------- */

.isim-satiri {
    flex-direction: row;
    align-items: center;
    margin: 6px 0;
}

.kok .isim-no {
    width: 80px;
    color: var(--yazi-soluk);
    -unity-text-align: middle-left;
}

.isim-kutusu {
    flex-grow: 1;
    margin: 0 16px 0 0;
}

.isim-kutusu .unity-base-text-field__input {
    background-color: var(--yuzey);
    border-color: var(--cizgi);
    border-width: 3px;
    border-radius: 20px;
    padding: 16px 24px;
    min-height: 100px;
    font-size: 44px;
    color: var(--yazi);
    -unity-text-align: middle-left;
}

.secenekler {
    flex-direction: row;
    flex-wrap: wrap;
}

.unity-button.secenek {
    min-height: 100px;
    margin: 8px 16px 8px 0;
    padding: 16px 32px;
    font-size: 38px;
}

.unity-button.secenek.secili {
    background-color: var(--alev);
    color: var(--yazi-koyu);
}

/* ---------- Oyun ekranı ---------- */

.oyun-ekrani {
    padding: 0;
}

.ust-cubuk {
    flex-direction: row;
    align-items: center;
    padding: 24px 56px 0 56px;
}

.kok .ust-cubuk-yazi {
    color: var(--yazi-soluk);
    font-size: 36px;
}

.govde {
    flex-grow: 1;
}

.parca {
    flex-grow: 1;
    padding: 32px 56px 48px 56px;
}

/* Oyuncu seçme çipleri */

.cipler {
    flex-direction: row;
    flex-wrap: wrap;
}

.unity-button.cip {
    flex-direction: row;
    align-items: center;
    background-color: var(--yuzey);
    border-width: 4px;
    border-color: var(--yuzey);
    border-radius: 60px;
    padding: 16px 32px;
    margin: 8px 16px 8px 0;
    min-height: 0;
}

.unity-button.cip.secili {
    border-color: var(--alev);
    background-color: var(--alev-koyu);
}

.renk-noktasi {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    margin-right: 16px;
}

.kok .cip-yazi {
    font-size: 42px;
    margin: 0;
}

/* Perde */

.perde {
    align-items: stretch;
}

.perde-renk {
    width: 180px;
    height: 180px;
    border-radius: 90px;
    align-self: center;
    margin-bottom: 40px;
}

.kok .perde-ust {
    color: var(--yazi-soluk);
    font-size: 46px;
    -unity-text-align: middle-center;
}

.kok .perde-buyuk {
    font-size: 96px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 24px 0;
}

.kok .perde-alt {
    color: var(--yazi-soluk);
    font-size: 38px;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

/* Soru sorma */

.soru-kutusu {
    margin: 16px 0 0 0;
}

.soru-kutusu .unity-base-text-field__input {
    background-color: var(--yuzey);
    border-color: var(--cizgi);
    border-width: 3px;
    border-radius: 24px;
    padding: 24px;
    min-height: 280px;
    font-size: 46px;
    color: var(--yazi);
    -unity-text-align: upper-left;
}

.soru-kutusu .unity-text-element {
    white-space: normal;
}

/* Cevap seçme: basılı tut ve oku */

.okuma-alani {
    background-color: var(--yuzey);
    border-color: var(--alev);
    border-width: 4px;
    border-radius: 32px;
    min-height: 440px;
    padding: 40px;
    margin: 16px 0 8px 0;
    justify-content: center;
    align-items: stretch;
}

.okuma-alani.basili {
    background-color: var(--alev-koyu);
}

.kok .okuma-ipucu {
    color: var(--yazi-soluk);
    font-size: 46px;
    -unity-text-align: middle-center;
}

.kok .okuma-soru {
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Mini oyun: bölünmüş ekran */

.bolunmus {
    padding: 0;
}

.yari {
    flex-grow: 1;
    flex-basis: 0;
    padding: 36px 48px;
}

.ters {
    rotate: 180deg;
}

.ayrac {
    height: 8px;
    background-color: var(--alev);
}

.kok .yari-isim {
    font-size: 56px;
    -unity-font-style: bold;
}

.kok .yari-rol {
    color: var(--yazi-soluk);
    font-size: 36px;
}

.kok .yari-durum {
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kok .banner {
    background-color: var(--alev-koyu);
    color: var(--alev);
    border-radius: 20px;
    padding: 16px 24px;
    margin: 12px 0;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.secimler {
    flex-direction: row;
    margin: 16px -8px 0 -8px;
}

.unity-button.secim {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px;
    padding: 16px 8px;
    min-height: 220px;
    font-size: 46px;
}

/* Sonuç: ifşa, güme, devir */

.el-karti {
    background-color: var(--yuzey);
    border-radius: 28px;
    padding: 28px 36px;
}

.kok .el-hamleler {
    font-size: 44px;
    -unity-text-align: middle-center;
}

.kok .el-kazanan {
    font-size: 52px;
    -unity-font-style: bold;
    color: var(--alev);
    -unity-text-align: middle-center;
}

.ifsa-karti {
    background-color: var(--alev);
    border-radius: 40px;
    padding: 56px 48px;
}

.kok .ifsa-karti .unity-label {
    color: var(--yazi-koyu);
    -unity-text-align: middle-center;
}

.kok .ifsa-baslik {
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: 8px;
}

.kok .ifsa-soru {
    font-size: 66px;
    -unity-font-style: bold;
    margin: 32px 0;
}

.kok .ifsa-alt {
    font-size: 40px;
}

.gume-karti {
    background-color: var(--yuzey);
    border-radius: 40px;
    padding: 56px 48px;
}

.kok .gume-baslik {
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 16px 0;
}

/* Oyun sonu */

.son-kart {
    background-color: var(--yuzey);
    border-radius: 24px;
    padding: 24px 32px;
    margin: 8px 0;
}

.kok .son-soru {
    font-size: 44px;
    -unity-font-style: bold;
}

/* Mini oyun: başlık ve küçük seçimler */

.yari-baslik {
    flex-shrink: 0;
}

.unity-button.secim.secim-kucuk {
    min-height: 120px;
}

.unity-button.secim.secili {
    background-color: var(--alev);
    color: var(--yazi-koyu);
}

/* Reaksiyon */

.reaksiyon-alani {
    flex-grow: 1;
    margin-top: 24px;
    border-radius: 36px;
    justify-content: center;
    align-items: center;
    transition-property: background-color;
    transition-duration: 0.05s;
}

.reaksiyon-bekle {
    background-color: #B3262B;
}

.reaksiyon-yesil {
    background-color: #2DBE6C;
}

.reaksiyon-basildi {
    background-color: var(--yuzey-2);
}

.kok .reaksiyon-yazi {
    font-size: 88px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Oyun sonu sayaçları */

.son-satir {
    margin: 4px 0;
}

/* ---------- S3: tekrar oynatma ---------- */

.kok .ust-cubuk-durum {
    color: var(--alev);
    margin-right: 24px;
}

/* Kaos: tur başında büyük duyuru */

.kaos-karti {
    background-color: #2A1240;
    border-color: #B36BFF;
    border-width: 4px;
    border-radius: 40px;
    padding: 40px 44px;
    margin: 16px 0;
}

.kok .kaos-ust {
    color: #B36BFF;
    font-size: 38px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kok .kaos-ad {
    font-size: 80px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 12px 0;
}

.kok .kaos-aciklama {
    font-size: 42px;
    color: var(--yazi);
    -unity-text-align: middle-center;
}

.kok .banner.kaos-serit {
    background-color: #2A1240;
    color: #D9B3FF;
    font-size: 34px;
    -unity-font-style: normal;
}

/* Kızgın Çakmak ısısı */

.kok .isi {
    font-size: 40px;
    -unity-font-style: bold;
    border-radius: 20px;
    padding: 12px 24px;
    margin: 12px 0 4px 0;
    -unity-text-align: middle-center;
}

.kok .isi-soguk { background-color: #12303A; color: #7FD3FF; }
.kok .isi-ilik { background-color: #3A3212; color: #FFD166; }
.kok .isi-sicak { background-color: #3A2212; color: #FF9F1C; }
.kok .isi-kizgin { background-color: #3A1212; color: #FF5A5F; }

.kok .banner.yanma {
    background-color: #3A1212;
    color: #FF5A5F;
    font-size: 46px;
}

/* Ceza kartları ve çark */

.ceza-alani {
    margin: 16px 0;
}

.kok .ceza-cark {
    font-size: 64px;
    -unity-font-style: bold;
    color: var(--alev);
    -unity-text-align: middle-center;
    padding: 40px 0;
}

.ceza-karti {
    border-radius: 28px;
    padding: 24px 32px;
    margin: 8px 0;
    border-width: 4px;
}

.ceza-sesli {
    background-color: #3A1A2A;
    border-color: #F15BB5;
}

.ceza-kisit {
    background-color: var(--yuzey);
    border-color: var(--cizgi);
}

.kok .ceza-kim {
    font-size: 40px;
    -unity-font-style: bold;
}

.kok .ceza-tur {
    font-size: 36px;
    color: var(--alev);
    -unity-font-style: bold;
    margin-top: 8px;
}

.kok .ceza-metin {
    font-size: 46px;
    margin: 8px 0;
}

/* Gizli görev */

.gorev-karti {
    background-color: var(--yuzey);
    border-color: var(--alev);
    border-width: 4px;
    border-radius: 40px;
    padding: 48px 44px;
    margin: 24px 0;
}

.kok .gorev-zorluk {
    color: var(--alev);
    font-size: 38px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kok .gorev-metin {
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 16px;
}

.gorev-basarili {
    border-left-width: 8px;
    border-left-color: #06D6A0;
}

.gorev-basarisiz {
    border-left-width: 8px;
    border-left-color: var(--cizgi);
}

.kok .gorev-durum {
    font-size: 34px;
    color: var(--yazi-soluk);
}

.gorev-basarili .gorev-durum {
    color: #06D6A0;
}

/* Unvanlar, grup, paylaşım kartı */

.unvan-karti {
    background-color: var(--alev-koyu);
    border-radius: 28px;
    padding: 24px 32px;
    margin: 8px 0;
}

.kok .unvan-ad {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--alev);
}

.kok .unvan-kim {
    font-size: 42px;
}

.grup-kutusu {
    margin: 8px 0;
}

.hafiza-karti {
    background-color: var(--yuzey);
    border-left-width: 8px;
    border-left-color: var(--alev);
    border-radius: 24px;
    padding: 24px 32px;
    margin: 16px 0;
}

.kart-perdesi {
    padding: 40px 56px;
    /* Opak: alttaki oyun sonu butonları kartın arkasından görünmesin. */
    background-color: rgb(10, 8, 14);
}

.paylasim-karti {
    flex-grow: 1;
    background-color: var(--yuzey);
    border-color: var(--alev);
    border-width: 4px;
    border-radius: 48px;
    padding: 56px 48px;
}

.kok .kart-grup {
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kart-butonlari {
    margin-top: 24px;
}

/* ---------- Online (S4/S5) ---------- */

.kod-kutusu .unity-base-text-field__input {
    -unity-font-style: bold;
    letter-spacing: 8px;
}

.oda-kodu-karti {
    align-items: center;
}

.kok .oda-kodu {
    font-size: 120px;
    -unity-font-style: bold;
    color: var(--alev);
    letter-spacing: 16px;
    margin: 8px 0 16px 0;
}

.lobi-oyuncu {
    background-color: var(--yuzey);
    border-radius: 20px;
    padding: 16px 24px;
    margin: 6px 0;
    min-height: 88px;
}

.kok .lobi-isim {
    font-size: 44px;
    color: var(--yazi);
    margin-left: 16px;
}

.kok .lobi-rozet {
    font-size: 30px;
    color: var(--yazi-koyu);
    background-color: var(--alev);
    border-radius: 16px;
    padding: 4px 14px;
    margin-left: 16px;
}

.kok .lobi-rozet.soluk {
    color: var(--yazi);
    background-color: var(--cizgi);
}

.soluk {
    opacity: 0.45;
}

/* Kısa bildirim: "Ali'nin sırası atlandı." Üstte, birkaç saniye. */
.kok .bildirim {
    background-color: var(--yuzey-2);
    border-color: var(--alev);
    border-width: 3px;
    border-radius: 24px;
    padding: 16px 28px;
    margin: 8px 0;
    font-size: 36px;
    color: var(--yazi);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Bağlanıyor katmanı her ekranın üstünde. */
.baglaniyor {
    background-color: rgba(10, 8, 14, 0.94);
}

.online-durumlar {
    justify-content: center;
    margin-top: 24px;
}

.cip-salt {
    flex-direction: row;
    align-items: center;
    background-color: var(--yuzey);
    border-radius: 60px;
    padding: 12px 24px;
    margin: 6px 10px 6px 0;
}

/* Sohbet (iskelet: protokol gelince açılır) */
.sohbet-kutu {
    flex-grow: 1;
    max-height: 90%;
}

.sohbet-liste {
    min-height: 300px;
}

.sohbet-satir {
    align-items: flex-start;
    margin: 6px 0;
}

.kok .sohbet-yazi {
    font-size: 36px;
    color: var(--yazi);
    white-space: normal;
    flex-shrink: 1;
    margin-left: 12px;
}

.sohbet-alt {
    margin-top: 8px;
}

/* ---------- PC: geniş pencere (Ana Plan 6.2) ----------
   Solda oyuncular, ortada aynı sütun, sağda sohbet. Uygulama.cs pencere yeterince genişse .kok'a "genis" ekler. */
.kok.genis {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

.kok.genis .sahne {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
}

.yan {
    width: 640px;
    flex-shrink: 0;
    padding: 48px 24px;
}

.yan .menu-kutu {
    padding: 32px;
    border-radius: 28px;
}

.sohbet-yan {
    flex-grow: 1;
}

.sohbet-yan .sohbet-kutu {
    max-height: 100%;
}

.oyuncu-sutunu {
    flex-shrink: 1;
}

/* ---------- Ayarlar ---------- */
.ayar-satiri {
    margin: 12px 0;
}

.ayar-kaydirici {
    margin: 8px 0;
    min-height: 60px;
}

.ayar-kaydirici #unity-dragger {
    width: 44px;
    height: 44px;
    margin-top: -18px;
    border-radius: 22px;
    background-color: var(--alev);
    border-width: 0;
}

.ayar-kaydirici #unity-tracker {
    height: 10px;
    background-color: var(--yuzey-2);
    border-width: 0;
    border-radius: 5px;
}

/* ---------- Köstebek ---------- */
/* Rol kartı: köstebek ve köstebek olmayan aynı boyda ve biçimde, sadece yazı ve kenar rengi farklı. */
.rol-karti {
    background-color: var(--yuzey);
    border-width: 4px;
    border-color: var(--cizgi);
    border-radius: 36px;
    padding: 32px 36px;
    margin: 16px 0;
}

.rol-karti.rol-kostebek {
    border-color: var(--kirmizi);
}

.kok .rol-ad {
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.suclama-dugmesi {
    margin: 12px 0;
}

.kostebek-acilis {
    background-color: var(--alev-koyu);
    border-width: 4px;
    border-color: var(--alev);
    border-radius: 36px;
    padding: 32px 36px;
    margin: 8px 0 24px 0;
    align-items: center;
}

.kostebek-acilis.kazanan-kostebek {
    border-color: var(--kirmizi);
}

.orta-satir {
    justify-content: center;
}

.kok .kostebek-isim {
    font-size: 72px;
    -unity-font-style: bold;
    margin-left: 16px;
}

.kok .kostebek-kazanan {
    font-size: 52px;
    -unity-font-style: bold;
    color: var(--alev-acik);
    -unity-text-align: middle-center;
}

/* ---------- Rus Ruleti ---------- */
.kok .banner.tetik-bam {
    background-color: #3A1212;
    color: var(--kirmizi);
    font-size: 48px;
    -unity-font-style: bold;
}

.kok .banner.tetik-tik {
    font-size: 44px;
}

.can-listesi {
    justify-content: center;
    margin: 12px 0;
}

.ayar-bolumu {
    margin: 0;
}

/* ---------- Takım Düellosu ---------- */
/* Motor sadece 0 ve 1 bilir; ad ve renk istemcide: 0 Kırmızı, 1 Mavi. */
:root {
    --takim-0: #FF5A5F;
    --takim-0-koyu: #3A1618;
    --takim-1: #4EA8FF;
    --takim-1-koyu: #142A44;
}

.takim-tabela {
    justify-content: center;
    align-items: center;
    margin: 12px 0;
}

.takim-skor {
    align-items: center;
    min-width: 240px;
    padding: 16px 28px;
    margin: 0 16px;
    border-radius: 28px;
    border-width: 4px;
}

.takim-skor.takim-0,
.takim-sutun.takim-0,
.kostebek-acilis.takim-0 {
    background-color: var(--takim-0-koyu);
    border-color: var(--takim-0);
}

.takim-skor.takim-1,
.takim-sutun.takim-1,
.kostebek-acilis.takim-1 {
    background-color: var(--takim-1-koyu);
    border-color: var(--takim-1);
}

.kok .takim-ad {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0 0 8px 0;
}

.kok .takim-puan {
    font-size: 96px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kok .takim-avans {
    font-size: 30px;
    color: var(--yazi-soluk);
    -unity-text-align: middle-center;
}

.kok .takim-hedef {
    -unity-text-align: middle-center;
}

.kok .takim-0 .takim-ad,
.kok .takim-0 .takim-puan,
.kok .takim-ust-puan.takim-0 {
    color: var(--takim-0);
}

.kok .takim-1 .takim-ad,
.kok .takim-1 .takim-puan,
.kok .takim-ust-puan.takim-1 {
    color: var(--takim-1);
}

/* Üst çubuktaki küçük skor */
.takim-ust {
    flex-direction: row;
    align-items: center;
    margin-left: 24px;
}

.kok .takim-ust-puan {
    font-size: 36px;
    -unity-font-style: bold;
    margin: 0 8px;
}

/* Puan anı: "+1 Mavi" */
.kok .banner.takim-0 {
    background-color: var(--takim-0-koyu);
    color: var(--takim-0);
}

.kok .banner.takim-1 {
    background-color: var(--takim-1-koyu);
    color: var(--takim-1);
}

.puan-ani {
    transition-property: scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.puan-ani-bas {
    scale: 1.35 1.35;
}

/* Seçim çipleri: kenar takım renginde; seçili olan yine alev */
.unity-button.cip.takim-cip.takim-0 {
    border-color: var(--takim-0);
}

.unity-button.cip.takim-cip.takim-1 {
    border-color: var(--takim-1);
}

.unity-button.cip.takim-cip.secili {
    border-color: var(--alev);
}

/* Dağıtma: iki sütun */
.takim-sutunlar {
    align-items: flex-start;
    margin: 8px 0;
}

.takim-sutun {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 160px;
    margin: 0 8px;
    padding: 16px;
    border-radius: 28px;
    border-width: 4px;
}

.takim-takimsiz {
    margin: 8px 0;
}

.kok .bildirim.takim-0 {
    border-color: var(--takim-0);
    color: var(--takim-0);
}

.kok .bildirim.takim-1 {
    border-color: var(--takim-1);
    color: var(--takim-1);
}

.kok .lobi-rozet.takim-0 {
    color: var(--takim-0);
}

.kok .lobi-rozet.takim-1 {
    color: var(--takim-1);
}

/* ---------- Casus ---------- */
.casus-seridi {
    padding: 12px 56px 0 56px;
    align-items: center;
}

.unity-button.buton-casus {
    background-color: var(--alev-koyu);
    color: var(--alev-acik);
    border-color: var(--alev);
    border-width: 3px;
}

.casus-liste {
    flex-direction: row;
    flex-wrap: wrap;
}

.unity-button.casus-oge {
    min-height: 88px;
    font-size: 36px;
    margin: 6px 12px 6px 0;
    padding: 12px 24px;
}

/* "Bu olamaz": sadece bu cihazda */
.unity-button.casus-oge.casus-isaretli {
    opacity: 0.35;
    background-color: var(--arka);
}

.kok .casus-salt {
    background-color: var(--yuzey);
    border-radius: 20px;
    padding: 12px 24px;
    margin: 6px 12px 6px 0;
    font-size: 36px;
}

.casus-rolum {
    align-items: flex-start;
    margin: 8px 0;
}

/* ---------- Çakmak Gecesi ---------- */
.rol-karti.taraf-Katil {
    border-color: var(--kirmizi);
}

.rol-karti.taraf-Tarafsiz {
    border-color: var(--alev);
}

/* Bulgu kutusu herkeste aynı yerde ve en az aynı boyda: kutudan rol anlaşılmasın. */
.gece-bulgu {
    background-color: var(--yuzey);
    border-radius: 20px;
    padding: 12px 20px;
    margin: 8px 0;
    min-height: 96px;
}

/* Gündüz yeteneği: rolü uymayanda da aynı yer kaplanır. */
.gece-yetenek {
    min-height: 120px;
    margin: 8px 0;
}

.kok .banner.gece-sabah {
    background-color: #1C2238;
    color: #B9C6FF;
}

.gece-ayarlari .gece-taraf-baslik {
    margin-top: 12px;
}

.gece-kulak {
    border-width: 3px;
    border-color: var(--alev);
}
